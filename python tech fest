def count_vowels(paragraph):
    vowels = "aeiouAEIOU"
    count = 0
    for char in paragraph:
        if char in vowels:
            count += 1
    return count

# Example usage
paragraph = "Hello world! This is a simple paragraph to count vowels."
print("Number of vowels:", count_vowels(paragraph))


